# Vector Database persistence directory
CHROMA_PERSIST_DIRECTORY=./vector_db

# CORS Origin for FastAPI
CORS_ORIGIN=http://localhost:5173

# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Cloud Storage & Firestore Configuration (Optional)
# Download your service account JSON from Firebase Console -> Project Settings -> Service accounts
FIREBASE_CREDENTIALS_PATH=./firebase_service_account.json
# Firebase Cloud Storage bucket name (e.g., your-project-id.appspot.com or your-project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
ADMIN_EMAIL=admin@summariser.ai
ADMIN_PASSWORD=YourAdminSecurePassword123!
