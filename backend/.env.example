# Vector Database persistence directory (relative to /backend)
CHROMA_PERSIST_DIRECTORY=./vector_db

# CORS Origin for FastAPI
CORS_ORIGIN=http://localhost:5173

# Optional LLM API Keys (If left empty, backend uses fast local semantic extractive synthesis!)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Firebase Cloud Storage & Firestore Configuration
# Path to your Firebase service account key (e.g. ./firebase_service_account.json)
FIREBASE_CREDENTIALS_PATH=./firebase_service_account.json
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
ADMIN_EMAIL=admin@summariser.ai
ADMIN_PASSWORD=YourAdminSecurePassword123!
